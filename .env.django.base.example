# Copy this file to .env.django.base and fill in the values.
# .env.django.base is NOT committed to git — keep secrets out of version control.
# DJANGO_ALLOWED_HOSTS is managed automatically by scripts/start_genaigrader.sh.
GOOGLE_OAUTH_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"

DJANGO_DEBUG=true
